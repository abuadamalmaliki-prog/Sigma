@charset "utf-8";

body { min-height: 100%; margin: 0px; padding: 0px; font-family: "Source Sans Pro", Arial, sans-serif; color: rgb(26, 26, 26); font-weight: 400; font-size: 15px; line-height: 1.5; background: -webkit-linear-gradient(top, rgb(140, 21, 21), rgb(242, 236, 232)) fixed; }

h1, h2, h3, h4, h5 { line-height: 1.2em; color: rgb(0, 0, 0); font-weight: 300; }

h2 { margin: 0.8em 0px 0.5em; font-size: 2em; }

h4 { font-weight: 400; }

h5 { font-size: 1.1em; font-weight: 500; }

h6 { font-size: 1.1em; font-weight: 400; font-style: italic; }

.bibliography h5 { margin-bottom: 0em; }

abbr[title], acronym[title] { text-decoration: none; }

li { line-height: 1.5; }

blockquote { border-left-width: medium; border-left-style: none; border-left-color: currentcolor; margin: 1em; padding: 0px; }

table { margin-bottom: 10px; }

a { text-decoration: inherit; font-style: inherit; color: inherit; }

#content a:link, #article-copyright a:link { text-decoration: underline; }

#aueditable a:link, #article-copyright a:link { text-decoration: underline; }

#toc a:link, #academic-tools a:link, #other-internet-resources a:link { text-decoration: none; }

a:link, a:visited { color: rgb(140, 21, 21); }

a:hover, a:focus, a:active { text-decoration: underline; color: rgb(0, 0, 0); }

hr { border-color: rgb(216, 216, 216); border-left-width: 0px; border-left-style: none; border-right-width: 0px; border-right-style: none; border-top-width: 0px; border-top-style: none; }

.btn { background: rgb(237, 235, 233); border: 1px solid rgb(215, 213, 211); box-shadow: none; text-shadow: none; margin: 0px 5px 5px 0px; transition: background 0.3s; }

.btn-large { font-size: 1.3em; font-weight: 300; letter-spacing: 0.02em; }

.btn:hover { background: rgb(214, 209, 205); color: rgb(0, 0, 0); border-color: rgb(192, 187, 181); transition: background 0.3s; }

a.btn { color: rgb(0, 0, 0); }

.btn i { font-size: 0.9em; margin-right: 0.3em; opacity: 0.6; transition: 0.3s; }

.btn:hover i { color: rgb(140, 21, 21); opacity: 1; }

.btn-group { width: 100%; background: rgb(255, 255, 255); border: 1px solid rgb(216, 216, 216); border-radius: 6px; }

.btn .caret { position: relative; inset: auto; float: right; margin: 0px 0.5em 0px 0px; opacity: 0.5; }

.dropdown-menu { margin-top: -2px; }

#navigation button.btn-navbar { font-weight: 300; }

#article-sidebar div.btn-navbar { }

#search-switch { font-family: "Source Sans Pro", Arial, sans-serif; color: rgb(0, 0, 0); }

#switch-text { display: inline-block; width: 8em; }

.width-100 { width: 100%; box-sizing: border-box; }

.no-wrap { white-space: nowrap; }

.sticky { z-index: 10; }

#container { max-width: 960px; margin-left: auto; margin-right: auto; box-shadow: rgb(115, 15, 15) 0px 10px 10px; padding: 0px 3em 1em; margin-bottom: 0px; background: -webkit-radial-gradient(center center, ellipse cover, rgb(255, 255, 255) 37%, rgb(242, 236, 232) 100%); }

#header-wrapper { padding-top: 2.5em; border-bottom: 1px solid rgb(216, 216, 216); background-image: url("../symbols/sep-shadow2.png"); background-position: center bottom; background-repeat: no-repeat; padding-bottom: 15px; }

#header { margin-bottom: 0px; }

#branding, #search, #navigation { display: inline-block; vertical-align: top; }

#branding, .homepage #branding { display: block; width: 100%; margin-bottom: 1em; padding-bottom: 2em; }

